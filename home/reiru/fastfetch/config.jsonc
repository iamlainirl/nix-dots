{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "nixos",
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": "blue"
  },

  "modules": [
    {
      "type": "custom",
      "format": "♡ welcome back 🐳"
    },
    "break",
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "up"
    },
    "break",
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu"
    },
    {
      "type": "memory",
      "key": "mem"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/"
    },
    "break",
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "packages",
      "key": "pkgs"
    }
  ]
}
